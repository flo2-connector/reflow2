 "nodes": [
  {
   "node_id": "con:ax-complex-field",
   "node_type": "Constraint",
   "properties": {
    "category": "technical",
    "concern": "core",
    "name": "Axiom: the complex numbers form a field",
    "priority": "medium",
    "statement": "The complex numbers form a field: addition and multiplication are associative and commutative, multiplication distributes over addition, with 0, 1, negatives and inverses of nonzero elements. \u03c0 and e are real, hence complex, numbers. (The ordinary laws of arithmetic used to expand a product of two binomials.)",
    "statement_kind": "axiom",
    "taken_as_given": true
   }
  },
  {
   "node_id": "con:def-algebraic",
   "node_type": "Constraint",
   "properties": {
    "category": "technical",
    "concern": "core",
    "name": "Definition: algebraic number",
    "priority": "medium",
    "statement": "A complex number \u03b1 is ALGEBRAIC when it is a root of some nonzero polynomial with rational coefficients: there are rationals c0, ..., cn, not all zero, with c0 + c1\u00b7\u03b1 + ... + cn\u00b7\u03b1\u207f = 0. (Clearing denominators, integer coefficients give the same notion.)",
    "statement_kind": "definition",
    "taken_as_given": true,
    "variables": [
     "\u03b1"
    ]
   }
  },
  {
   "node_id": "con:def-transcendental",
   "node_type": "Constraint",
   "properties": {
    "category": "technical",
    "concern": "core",
    "name": "Definition: transcendental number",
    "priority": "medium",
    "statement": "A complex number is TRANSCENDENTAL when it is not algebraic. So 'at least one of a, b is transcendental' says exactly 'not both a and b are algebraic'.",
    "statement_kind": "definition",
    "taken_as_given": true
   }
  },
  {
